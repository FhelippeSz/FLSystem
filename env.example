# Copie para .env.local (desenvolvimento) ou defina estas variáveis no painel do Vercel.
# Sem elas o sistema funciona normalmente, salvando apenas neste navegador (localStorage).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-CHAVE-ANON-PUBLICA

# Opcional: identificador da loja (permite várias lojas no mesmo projeto Supabase)
VITE_PDV_STORE_ID=loja-principal
